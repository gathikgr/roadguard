FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-model.txt constraints-model.txt ./
RUN pip install --no-cache-dir -r requirements-model.txt
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && pip install --no-cache-dir git+https://github.com/ultralytics/CLIP.git@7ffa84b3bfa40c42ecc1c77147a855e69cb2dd40 \
    && apt-get purge -y --auto-remove git \
    && rm -rf /var/lib/apt/lists/*
RUN pip uninstall -y opencv-python && pip install --no-cache-dir --no-deps --force-reinstall opencv-python-headless==4.12.0.88
COPY app ./app
CMD ["python", "-m", "app.worker"]
